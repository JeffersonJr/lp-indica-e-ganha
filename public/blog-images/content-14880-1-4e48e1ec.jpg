			<style type="text/css">/* widget: Post Magazine Grid */

#uc_post_magazine_grid_elementor18339 *
{
  box-sizing:border-box;
}
#uc_post_magazine_grid_elementor18339
{
  display: grid;
  grid-auto-rows: 1fr;
}

#uc_post_magazine_grid_elementor18339 div.ue-grid-item
{
  overflow:hidden;
  display:flex;
  position:relative;
}

#uc_post_magazine_grid_elementor18339 .ue-grid-item-image img
{
  width:100%;
  display:block;
}


#uc_post_magazine_grid_elementor18339.ue-layout-cover .ue-grid-item-image
{
  position:absolute;
  top:0;
  left:0;
  bottom:0;
  right:0;
}

#uc_post_magazine_grid_elementor18339.ue-layout-cover .ue-grid-item-image img
{
  height:100%;
  object-fit: cover;
}

#uc_post_magazine_grid_elementor18339.ue-layout-cover .ue-grid-item-content
{
  position:absolute;
  width:100%;
  bottom:0px;
}

#uc_post_magazine_grid_elementor18339 .ue-grid-item-image-overlay
{
  position:absolute;
  width:100%;
  top:0;
  display:block;
  bottom:0;
  height:100%;
  transition:0.3s;
}

.ue-grid-item-title a
{
  font-size:21px;
  font-weight:bold;
}

.ue-grid-item-category a
{
  display:inline-block;
  font-size:10px;
  text-transform:uppercase;
}

#uc_post_magazine_grid_elementor18339 .uc_more_btn{

  text-align:center;
  text-decoration:none;
  transition:0.3s;
}

#uc_post_magazine_grid_elementor18339 .ue-grid-item-meta-data
{
  display:flex;
  flex-wrap: wrap;
}

.ue-grid-item-meta-data
{
  font-size:12px;
}

#uc_post_magazine_grid_elementor18339 .ue-grid-item-meta-data-icon
{
  line-height:1em;
}

#uc_post_magazine_grid_elementor18339 .ue-grid-item-meta-data-icon svg
{
  width:1em;
  height:1em;
}


@media only screen and (max-width: 600px) {

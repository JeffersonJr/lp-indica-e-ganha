    <script type="rocketlazyloadscript">window.addEventListener('DOMContentLoaded', function() {
        jQuery(document).ready(function ($) {
            const swiperContainer = $('.fia-eventos-wrapper .mySwiper');
            const totalSlides = swiperContainer.find('.swiper-slide').length;
            
            let slidesToShow = 4;

            var swiper = new Swiper(".mySwiper", {
                slidesPerView: totalSlides,                
                spaceBetween: 10,
                centeredSlides: false,
                watchOverflow: false,
                loop: true,
                autoplay: {
                delay: 5000,
                 disableOnInteraction: false,
                },
                pagination: {
                    el: ".swiper-pagination",
                    clickable: true,
                },
                navigation: {
                    nextEl: ".swiper-button-next",
                    prevEl: ".swiper-button-prev",
                },
                breakpoints: {
                    1280: { slidesPerView: totalSlides < 4 ? totalSlides : 4, }, // desktops grandes
                    1024: { slidesPerView: totalSlides < 3 ? totalSlides : 3, }, // notebooks
                    768: { slidesPerView: totalSlides < 2 ? totalSlides : 2, },  // tablets
                    0: { slidesPerView: totalSlides < 1 ? totalSlides : 1,  },  // celulares
                },
            });

            // Adiciona o evento de pausa no hover
            const swiperEl = document.querySelector('.mySwiper');

            swiperEl.addEventListener('mouseenter', function() {
                swiper.autoplay.stop(); // pausa autoplay
            });

            swiperEl.addEventListener('mouseleave', function() {
                swiper.autoplay.start(); // retoma autoplay
            });

            function ajustarJustify() {
                const $wrapper = swiperContainer.find('.swiper-wrapper');
                let justify = 'normal';

                if (window.innerWidth >= 1280) {
                    if (totalSlides < 4) justify = 'center';
                } 
                else if (window.innerWidth >= 1024) {
                    if (totalSlides < 3) {
                        justify = 'center';
                        swiperContainer.addClass('swiper-few-slides-1024');
                    } else {
                        swiperContainer.removeClass('swiper-few-slides-1024');
                    }
                } 
                else if (window.innerWidth >= 768) {
                    if (totalSlides < 2) justify = 'center';
                }
                else if (window.innerWidth < 700) {
                    if (totalSlides <= 2) justify = 'normal';
                }
                // breakpoint 0 → sempre normal

                swiper.on('breakpoint', ajustarJustify);

                $wrapper.css({
                    'display': 'flex',
                    'justify-content': justify
                });
            }

            ajustarJustify();



        });
    });</script>

</div>
